# Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example is committed.
# The human adds real values to .env by hand.

### Auth / Email (reused from Assessment 1, AuthSlice)

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Get this from your local PostgreSQL instance or a managed provider.
# DATABASE_URL="postgresql://user:password@localhost:5432/ai_integration_slice"

# Node environment
# NODE_ENV="development"

# Public app URL (used in password-reset email links)
# APP_URL="http://localhost:3000"

# SMTP (optional — when unset, Ethereal test accounts are used in development)
# To use a real mail server, fill these in and the app will use them.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_FROM="AI Integration Slice <noreply@example.com>"
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"

### AI Integration Slice (Assessment 3)

# Gemini API key used for handwritten-note extraction
# Get this from Google AI Studio: https://aistudio.google.com → Get API key
# GEMINI_API_KEY="your-gemini-api-key"

# DeepSeek API key used for the follow-up action (summarise/rephrase/expand)
# Get this from the DeepSeek platform: https://platform.deepseek.com → API Keys
# DEEPSEEK_API_KEY="your-deepseek-api-key"

# Cloudflare R2 account ID
# Cloudflare dashboard → R2 → Account ID (top-right of the R2 overview page)
# R2_ACCOUNT_ID="your-r2-account-id"

# Cloudflare R2 API token credentials
# R2 → Manage R2 API Tokens → Create API token
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# Cloudflare R2 bucket name (create it in R2 before first run)
# R2_BUCKET_NAME="your-r2-bucket-name"

# Cloudflare R2 S3-compatible endpoint
# Typically https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT="https://your-r2-account-id.r2.cloudflarestorage.com"

# Redis connection string, used by BullMQ for the job queue
# Get this from a local Redis install or a hosted provider (e.g. Upstash, Redis Cloud).
# REDIS_URL="redis://localhost:6379"